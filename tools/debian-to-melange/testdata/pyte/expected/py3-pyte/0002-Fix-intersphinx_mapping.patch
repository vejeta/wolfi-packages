From: Florian Ernst <florian@debian.org>
Date: Mon, 30 Dec 2024 09:10:27 +0100
Subject: Fix intersphinx_mapping to point to docs shipped by the python3-doc
 package

Bug-Debian: https://bugs.debian.org/1090126
Forwarded: https://github.com/selectel/pyte/issues/191
---
 docs/conf.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/docs/conf.py b/docs/conf.py
index 4b9eeed..1434980 100644
--- a/docs/conf.py
+++ b/docs/conf.py
@@ -176,7 +176,9 @@ else:
 htmlhelp_basename = 'pytedoc'
 
 # Example configuration for intersphinx: refer to the Python standard library.
-intersphinx_mapping = {'http://docs.python.org/': None}
+intersphinx_mapping = {
+    'python': ('/usr/share/doc/python3-doc/html', '/usr/share/doc/python3-doc/html/objects.inv'),
+}
 
 autodoc_member_order = 'bysource'
 todo_include_todos = True
