#!/usr/bin/make -f

include /usr/share/dpkg/default.mk

# The server.js version this package fetches, and its real sha256sum.
# Update both together -- see debian/README.source for how.
SERVER_VERSION = 4.21.1
SERVER_SHA256 = 405eb494d6708406a30e716c3cfb5abae7a5e9c7a8b79446d64c3f821385930f

%:
	dh $@

override_dh_installdeb:
	sed -e 's/#VERSION#/$(SERVER_VERSION)/g' \
	    -e 's/#HASH#/$(SERVER_SHA256)/g' \
	    debian/postinst.in > debian/postinst
	dh_installdeb

override_dh_clean:
	debconf-updatepo
	dh_clean
	rm -f debian/postinst
