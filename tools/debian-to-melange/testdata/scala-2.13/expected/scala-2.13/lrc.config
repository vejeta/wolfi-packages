# licenserecon configuration for scala-2.13
#
# Aliases (d/copyright name | licensecheck name):
#
# The highlight.js licence is BSD-3-clause with "highlight.js" named in
# clause 3; it gets its own short name in d/copyright so its text is
# reproduced exactly.
BSD-3-clause-highlight | BSD-3-clause
#
# The octicons files carry both licences (the fonts state "Font License:
# SIL OFL 1.1 ... Code License: MIT" in their metadata); licensecheck
# reports only the MIT part.
Expat and OFL-1.1 | Expat
#
# licensecheck does not report the Classpath exception.
GPL-2 with Classpath exception | GPL-2.0-only

# The header is the Scala Apache-2.0 one; licensecheck also matches a
# comment crediting Doug Lea's public domain code (see d/copyright).
src/library/scala/concurrent/impl/Promise.scala

# This file is scanned too.
debian/lrc.config
