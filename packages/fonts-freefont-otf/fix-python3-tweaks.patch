index 242edb9..40f0164 100644
--- a/tools/generate/tweeks/OpenType/checksum.py
+++ b/tools/generate/tweeks/OpenType/checksum.py
@@ -62,7 +62,9 @@ class BigEndian32BitList:
 				self.accumByte( 0xFF & ( v >> shift ) )
 		elif size == 10:
 			for i in range( 0, size ):
-				v = ord( val[i] )
+				v = val[i]
+				if not isinstance( v, int ):
+					v = ord( v )
 				#print( "FLAG",  "{0:d}".format( v ) )
 				self.accumByte( 0xFF & v )
 		else:
diff --git a/tools/generate/tweeks/OpenType/table.py b/tools/generate/tweeks/OpenType/table.py
index 75b1ef3..74c1f84 100644
--- a/tools/generate/tweeks/OpenType/table.py
+++ b/tools/generate/tweeks/OpenType/table.py
@@ -103,23 +103,28 @@ class BaseTable( object ):
 			return self.__dict__[name]
 		if not '_struct' in self.__dict__:
 			raise Exception( "No _struct member: " + str( self ) )
-		if name in self._struct.__dict__:
-			return self._struct.__dict__[name]
+		if name in self._struct._fields:
+			return getattr( self._struct, name )
 		else:
 			raise KeyError( "item " + name + " not found" )
 
 	def __setattr__( self, name, value ):
 		if( '_struct' in self.__dict__
-		and name in self.__dict__['_struct'] ):
-			self._struct.name = value
+		and name in self._struct._fields ):
+			self.__dict__['_struct'] = self._struct._replace(
+				**{ name: value } )
 		else:
 			self.__dict__[name] = value
 
 	def __getitem__( self, key ):
-		return self._struct[key]
+		return getattr( self._struct, key )
 
 	def __setitem__( self, key, value ):
-		self._struct[key] = value
+		if key in self._struct._fields:
+			self.__dict__['_struct'] = self._struct._replace(
+				**{ key: value } )
+		else:
+			raise KeyError( "item " + key + " not found" )
 
 	def __str__( self ):
 		self._astr = ''
diff --git a/tools/generate/tweeks/OpenType/typeutils.py b/tools/generate/tweeks/OpenType/typeutils.py
index 9349f60..e58108c 100644
--- a/tools/generate/tweeks/OpenType/typeutils.py
+++ b/tools/generate/tweeks/OpenType/typeutils.py
@@ -50,6 +50,7 @@ def bitfield2str( val, fieldlen = 16 ):
 	return ''.join( s )
 
 def panose_str( val ):
-	v = str( val )
-	s = [ "{:X}".format( ord( v[i] ) ) for i in range( 0, 10 ) ]
+	if not isinstance( val, ( bytes, bytearray ) ):
+		val = str( val ).encode( 'latin-1' )
+	s = [ "{:X}".format( b ) for b in val[:10] ]
 	return '|'.join( s ) 
