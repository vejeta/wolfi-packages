From: Stephane Glondu <steph@glondu.net>
Date: Thu, 26 Feb 2026 16:02:49 +0100
Subject: Do not call Unix.create_process with empty args

This does not work on hurd-amd64.
---
 test/e2e/alcotest/source_code_position/caml_ld_library_path.ml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/test/e2e/alcotest/source_code_position/caml_ld_library_path.ml b/test/e2e/alcotest/source_code_position/caml_ld_library_path.ml
index 23db76f..dd88ba6 100644
--- a/test/e2e/alcotest/source_code_position/caml_ld_library_path.ml
+++ b/test/e2e/alcotest/source_code_position/caml_ld_library_path.ml
@@ -12,7 +12,7 @@ let () =
   in
   Unix.putenv "CAML_LD_LIBRARY_PATH" paths;
   let child =
-    Unix.create_process test [||] Unix.stdin Unix.stdout Unix.stderr
+    Unix.create_process test [| test |] Unix.stdin Unix.stdout Unix.stderr
   in
   match Unix.waitpid [ WUNTRACED ] child with
   | _, WEXITED c -> exit c
