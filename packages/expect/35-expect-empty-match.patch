From: Andrew Burgess
Subject: Patch fixes matching empty substring at start of buffer
Last-Modified: Sat, 25 Apr 2026 13:39:55 +0300
Bug: https://sourceforge.net/p/expect/patches/26/

--- a/expect.c
+++ b/expect.c
@@ -2304,7 +2304,10 @@
 
 				/* string itself */
 		sprintf(name,"%d,string",i);
-		val = Tcl_GetRange(buf, start, end);
+                if (end >= start)
+                    val = Tcl_GetRange(buf, start, end);
+                else
+                    val = Tcl_NewStringObj("", 0);
 		expDiagLog("%s: set %s(%s) \"",detail,EXPECT_OUT,name);
 		expDiagLogU(expPrintifyObj(val));
 		expDiagLogU("\"\r\n");
--- a/tests/expect.test
+++ b/tests/expect.test
@@ -153,6 +153,32 @@
     set x
 } {1}
 
+test expect-1.14 {re pattern, sub matches} {
+    expect "*"
+    exp_send "abc\r"
+
+    set timeout 10
+    set x 0
+    expect -indices -re "^(a?)(a)(bc)" {
+        incr x
+        if { $expect_out(0,string) eq "abc" } { incr x }
+        if { $expect_out(0,start) == 0 } { incr x }
+        if { $expect_out(0,end) == 2 } { incr x }
+
+        if { $expect_out(1,string) eq "" } { incr x }
+        if { $expect_out(1,start) == 0 } { incr x }
+        if { $expect_out(1,end) == -1 } { incr x }
+
+        if { $expect_out(2,string) eq "a" } { incr x }
+        if { $expect_out(2,start) == 0 } { incr x }
+        if { $expect_out(2,end) == 0 } { incr x }
+
+        if { $expect_out(3,string) eq "bc" } { incr x }
+        if { $expect_out(3,start) == 1 } { incr x }
+        if { $expect_out(3,end) == 2 } { incr x }
+    }
+    set x
+} {13}
 
 close
 wait
